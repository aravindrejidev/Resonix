<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MediaStore library scan (Phase 2B). Requested at runtime, not just
         declared here — see MainActivity's permission launcher. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- PlaybackService — required for a foregroundServiceType="mediaPlayback"
         service on API 29+, with the second permission specifically required
         on API 34+. POST_NOTIFICATIONS is the runtime permission (API 33+) for
         the playback notification; WAKE_LOCK keeps the CPU awake while music
         plays with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 14 bit-perfect mixer for USB DACs (AudioManager.setPreferredMixerAttributes). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Declares interest in low-latency / pro audio hardware without excluding
         devices that lack it (required="false"). Relevant to the Oboe/AAudio
         exclusive-mode engine this app is built around. -->
    <uses-feature
        android:name="android.hardware.audio.low_latency"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.audio.pro"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Resonix">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Resonix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only ever started by the app itself (PlaybackController, and the
             notification's own buttons), so it is not exported. -->
        <service
            android:name=".playback.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

    </application>

</manifest>
